# Paste your Firebase web app config as JSON, or fill the separate keys below.
VITE_FIREBASE_CONFIG=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional fixed vault key for all your devices (no email login).
# Same value on PC / iMac / phone = same cloud data under owners/{key}.
# You can also set this in Settings → Cloud sync.
VITE_DAYLIGHT_SYNC_KEY=nikita-daylight

# Gemini key used by the desktop planner + morning opportunity scout.
# Restrict this key to the Generative Language API.
# Note: Cursor / Gemini app subscriptions do NOT cover this API key.
# OpenAlex paper lookup is free. Google Search grounding on Gemini 2.5 Flash
# has a free AI Studio daily quota; Gemini 3.x search needs a paid API project.
VITE_GEMINI_API_KEY=
